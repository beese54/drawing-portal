FROM node:24-alpine
WORKDIR /app
# Run as the image's built-in non-root user. It must own /app because Vite
# writes its dependency cache to node_modules/.vite at startup.
RUN chown node:node /app
USER node
COPY --chown=node:node package.json package-lock.json* ./
RUN npm ci
COPY --chown=node:node . .
EXPOSE 5173
# 127.0.0.1, not localhost: Vite listens on IPv4 0.0.0.0, and localhost can
# resolve to ::1 first.
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=5 \
    CMD wget -q -O /dev/null http://127.0.0.1:5173/ || exit 1
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
