# Copy this to secret.yaml (gitignored), fill in a real random token, then
# `kubectl apply -f k8s/backend/secret.yaml`. Never commit the real value.
apiVersion: v1
kind: Secret
metadata:
  name: backend-secrets
  namespace: schematic-portal
type: Opaque
stringData:
  FEEDBACK_ADMIN_TOKEN: "replace-with-a-random-token"
