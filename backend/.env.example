# Copy this file to .env and set values only if you need to override a default.
# NEVER commit .env to git.
#
# The application has no secrets. The symbol write API and its SYMBOLS_ADMIN_KEY
# were removed on 2026-08-04 — the symbol library is built into the image and is
# read-only at runtime.

# Where the built-in symbol library lives. Defaults correctly in the image;
# docker-compose overrides it to match its bind mount.
# SYMBOLS_PATH=/app/symbols

# Where the built frontend is served from. Only set in the combined image.
# STATIC_PATH=/app/static
