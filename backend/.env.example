# Copy this file to .env and fill in your API keys.
# NEVER commit .env to git.

# OpenAI API key — used for GPT-4o-mini compliance evaluation
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Together AI API key — used for Qwen2.5-72B open-source model (free tier available)
# Get your key at: https://api.together.xyz
TOGETHER_API_KEY=your-together-ai-key-here

# Required to use custom-symbol upload/rename/delete (POST/PATCH/DELETE
# /api/symbols). Unset = those endpoints are unusable (fail closed), not
# open. Generate a random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
SYMBOLS_ADMIN_KEY=
