# Copy this file to .env and fill in the values you need.
# NEVER commit .env to git.

# Required to use custom-symbol upload/rename/delete (POST/PATCH/DELETE
# /api/symbols). Unset = those endpoints are unusable (fail closed), not
# open. Generate a random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
SYMBOLS_ADMIN_KEY=
