# Test-only dependencies, compiled with the runtime ones into
# requirements-dev.txt (hashed, like requirements.txt; recompile as described
# in requirements.in). None of this reaches the runtime image: the Dockerfile
# installs requirements.txt alone.
-r requirements.in
# The runtime packages resolve to exactly the production lock's versions, so
# CI tests what ships.
-c requirements.txt

